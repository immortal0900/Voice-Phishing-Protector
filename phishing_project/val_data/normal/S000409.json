                    "age": "40대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                },
                {
                    "id": "2",
                    "type": "상담사1",
                    "age": "20대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0001.wav",
                "duration": 10.571,
                "text": "한국사를 더 추가하게 되면은 비용이 어떻게 되고 전과목을 하게 되면 어떻게 되는지 그냥 혹시 지금 행사하고 있는 게 있는지 좀 알아보려고 전화 드렸어요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0002.wav",
                "duration": 8.179,
                "text": "아 네, 네, 지금 단과는 이제 구매하시려는 강좌마다 기간이랑 금액이 달라서 먼저"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0003.wav",
                "duration": 3.274,
                "text": "단과로 이제 신청하실 경우에는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0004.wav",
                "duration": 3.859,
                "text": "단과 할 수 있는 강좌마다 기간이랑 금액이 달라요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0005.wav",
                "duration": 5.555,
                "text": "o/ 그래서 직접 선생님분 선택을 하셔서 그 강좌를 보셔야"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0006.wav",
                "duration": 3.7,
                "text": "o/ 금액이랑 기간을 확인할 수가 있고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0007.wav",
                "duration": 3.912,
                "text": "그 정가에서 할인하고 있고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0008.wav",
                "duration": 4.539,
                "text": "현재 기본이 (490000원)/(사십 구만 원)에 판매하고 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0009.wav",
                "duration": 2.429,
                "text": "뭐 전과목이요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0010.wav",
                "duration": 4.947,
                "text": "o/ 네, 전과목 그니까 학년 구분 없이 전 학년"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0011.wav",
                "duration": 2.511,
                "text": "교재는 빼고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0012.wav",
                "duration": 2.44,
                "text": "(490000원)/(사십 구만 원)에"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0013.wav",
                "duration": 3.987,
                "text": "뭐 대신 교재는 다 사야 되는 거죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0014.wav",
                "duration": 2.973,
                "text": "교재는 별도 (구매고요)/(구매구요)?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0015.wav",
                "duration": 6.613,
                "text": "전 학년에 전 강좌를 올해 (12월)/(십 이 월) (31일)/(삼십 일 일)까지 자유롭게 수강하실 수가 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0016.wav",
                "duration": 3.367,
                "text": "(12월)/(십 이 월) (31일)/(삼십 일)이면 올해 말까지네요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0017.wav",
                "duration": 3.347,
                "text": "네, 근데 다 이제 안되는 거는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0018.wav",
                "duration": 11.02,
                "text": "논술 중에서 첨삭 강좌랑 단과가 (2개)/(두 개) 묶인 패키지랑 적성 검사 이런 부분 빼고는 뭐 들을 수 있다고 보시면 돼요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0019.wav",
                "duration": 10.244,
                "text": "o/ 아 혹시 그러면 선생님마다 강의마다 비용은 다르는 건는 알겠는데 대략이나 비용이 아주 큰 차이는 없잖아요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0020.wav",
                "duration": 4.765,
                "text": "그러면은 혹시 조금 생각하고 계시는 선생님이 있으신가요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0021.wav",
                "duration": 7.013,
                "text": "대략으로 한 국어 수학 아니 뭐지 사회하고 한국사만 들었을 때"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0022.wav",
                "duration": 10.667,
                "text": "추가되는 비용이 얼마나 될까요? 왜냐하면 저희가 지금 과학을 듣고 있거든요. 그렇게 이렇게 되면 과학은 환불을 받고 전과목을 들어가야 되는 거잖아요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0023.wav",
                "duration": 2.376,
                "text": "그쵸? 그게 나으시죠."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0024.wav",
                "duration": 4.61,
                "text": "그거 보고 이해 타산 좀 따져보고 싶어서 전화드렸거든요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0025.wav",
                "duration": 8.445,
                "text": "혹시 저희 들어가 있으면 저희 기본 그거 보고서는 쟤 과학을 취소했을 때 얼마가 환불되고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0026.wav",
                "duration": 6.065,
                "text": "전과목 들어갈 때 (490000원)/(사십 구만 원) 정도 들어가니까 얼마 더 추가해야 한다는 거 하고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0027.wav",
                "duration": 17.256,
                "text": "그 다음에 그 과학을 듣고 있는 상태에서 지금 문제는 저희가 한국사하고 사회에만 듣고 싶은 거는 사실인 거거든요. 근데 국영수는 좀 뭐 알파로 있으면 좋고 없으면 말고라는 생각을 갖고 있어서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0028.wav",
                "duration": 3.6,
                "text": "네, 어 좀 비교해봐 주실 있으실까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0029.wav",
                "duration": 5.011,
                "text": "아 네, 네, 말씀을 드리면 주로 이제"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0030.wav",
                "duration": 4.061,
                "text": "한국사랑 사회는 고 (1)/(일)이시라면은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0031.wav",
                "duration": 3.933,
                "text": "선생님을 많이 수강하시기는 하세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0032.wav",
                "duration": 3.645,
                "text": "o/ 그래서 통합으로 진행이 되시는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0033.wav",
                "duration": 3.005,
                "text": "강좌 금액을 말씀드리면"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0034.wav",
                "duration": 4.915,
                "text": "확실한 통합 사회의 내신 완성이 강좌 비용이 (80000원)/(팔만 원)이고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0035.wav",
                "duration": 2.512,
                "text": "할마서 (80000원)/(팔만 원)"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0036.wav",
                "duration": 4.372,
                "text": "올해 말까지가 (일) (12월)/(십 이 월) 말까지가 (80000원)/(팔만 원)이요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0037.wav",
                "duration": 6.643,
                "text": "아니요. 이거는 (83일)/(팔십 삼 일) 동안 수강이 가능해요. 단과로 보시는 거라서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0038.wav",
                "duration": 5.003,
                "text": "o/ 네, 그러면은 그 다음에 사회 그 다음에 한국사는요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0039.wav",
                "duration": 3.207,
                "text": "한국사로 넘어가신다면은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0040.wav",
                "duration": 7.976,
                "text": "완벽한 한국사 개념 완성 (50000원)/(오만 원)이고 내신쪽으로 가면은 (120000원)/(십 이만 원) 이렇게 돼요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0041.wav",
                "duration": 2.931,
                "text": "내신은 (120000원)/(십 이만 원)이요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0042.wav",
                "duration": 4.653,
                "text": "네, 고 (1)/(일)로 보신다면 (120000원)/(십 이만 원)이라고 보시면 되고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0043.wav",
                "duration": 2.628,
                "text": "이것도 똑같이 (83일)/(팔십 삼 일)이요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0044.wav",
                "duration": 2.963,
                "text": "수강 기간이 (131일)/(백 삼십 일 일)이에요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0045.wav",
                "duration": 3.016,
                "text": "한국사는 또 (131일)/(백 삼십 일 일)이에요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0046.wav",
                "duration": 2.749,
                "text": "네, 단과로 하신다면요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0047.wav",
                "duration": 8.387,
                "text": "네, 그러면 한국사는 (131일)/(백 삼십 일 일)에 (120000원)/(십 이만 원)이고 사회에는 (83일)/(팔십 삼 일)에 (80000원)/(팔만 원)이란 말씀이신거죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0048.wav",
                "duration": 2.931,
                "text": "네, 그래서 제가 설명드린건"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0049.wav",
                "duration": 2.882,
                "text": "선생님 고 (1)/(일) 강좌이고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0050.wav",
                "duration": 7.453,
                "text": "네, 그 패스로 하신다면은 그 (2강좌)/(두 강좌)를 올해 (12월)/(십 이 월) 말까지 자유롭게 수강하실 수가 있는 (거고요)/(거구요)."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0051.wav",
                "duration": 2.952,
                "text": "o/ 이제 단과 과학"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0052.wav",
                "duration": 5.331,
                "text": "o/ 그죠? 국영수도 다 들어가는 거죠? 패스로 하면요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0053.wav",
                "duration": 4.104,
                "text": "하면 국영수 포함해서 다 들을 수가 있는 (거고요)/(거구요)."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0054.wav",
                "duration": 3.347,
                "text": "o/ 과학 만일 환불 네,"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0055.wav",
                "duration": 2.312,
                "text": "네, 해주세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0056.wav",
                "duration": 9.491,
                "text": "아 네, 환불을 진행한다 하시면 수강이 어느 정도 있어서 원래는 (38864월)/(삼만 팔천 팔백 육십 사 원) 환불이 가능해요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0057.wav",
                "duration": 5.554,
                "text": "(38864원)/(삼만 팔천 팔백 육십 사 원) 환불이 가능하신데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0058.wav",
                "duration": 5.427,
                "text": "총 처음에 결제하셨던 금액은 (114000원)/(십 일만 사천 원)이시고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0059.wav",
                "duration": 4.776,
                "text": "(53040원)/(오만 삼천 사십 원)까지 현금 환불해 드릴 수 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0060.wav",
                "duration": 3.368,
                "text": "(54300원)/(오만 사천 삼백 원) 정도요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0061.wav",
                "duration": 3.016,
                "text": "(53040원)/(오만 삼천 사십 원)"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0062.wav",
                "duration": 4.125,
                "text": "(50000)/(오만) (53030원)/(오만 삼천 삼십 원)이요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0063.wav",
                "duration": 5.043,
                "text": "네, (50000)/(오만) (53000원)/(오만 삼천 원) 돈이라 생각하면 되겠네요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0064.wav",
                "duration": 4.89,
                "text": "네, 오 선생님 왜 사회 (83일)/(팔십 삼 일) 밖에 안돼요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0065.wav",
                "duration": 8.595,
                "text": "이거는 근데 강좌가 적어요. 강좌가 (14강)/(십 사 강)이에요. (83일)/(팔십 삼 일)에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0066.wav",
                "duration": 3.79,
                "text": "(8)/(팔) 수강기간은 (83일)/(팔십 삼 일)이고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0067.wav",
                "duration": 5.128,
                "text": "통합 사회 강좌 구성은 총 (24강)/(이십 사 강)으로 구성이 되어있고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0068.wav",
                "duration": 5.363,
                "text": "네, 그 (24강)/(이십 사 강)이 한번에 다 올라오나요? 그렇진 않죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0069.wav",
                "duration": 2.099,
                "text": "지금 잠시만요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0070.wav",
                "duration": 4.339,
                "text": "아이들의 진도에 맞춰서 올라오죠? 보통요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0071.wav",
                "duration": 4.79,
                "text": "네, 순차 지금 진행이 되는데 이거 완강 되신 강좌예요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0072.wav",
                "duration": 2.446,
                "text": "완강이라는 것은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0073.wav",
                "duration": 2.568,
                "text": "o/ 전부 다 올라온 거"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0074.wav",
                "duration": 6.365,
                "text": "아 전부 다 올라온 거예요? 그럼 혹시 만약에 이렇게 완강으로 올라온 강좌들 같은 경우는"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0075.wav",
                "duration": 5.405,
                "text": "먼저 (43일)/(사십 삼 일) 이내에 다운 받아놓고 계속 볼 수 있는 건가요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0076.wav",
                "duration": 5.693,
                "text": "네, 수강기간 종료일까지는 다운 받아 놓으시면 보실 수가 있고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0077.wav",
                "duration": 6.333,
                "text": "네, 그럼 제가 만약에 다운 받아놨으면 그건 계속 볼 수 있는 거잖아요. 제 입장에서는요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0078.wav",
                "duration": 5.512,
                "text": "음 그러면 이런 (강) 한국사하고 사회 같은 경우는"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0079.wav",
                "duration": 8.296,
                "text": "뭐 중간고사나 기말 대비 뭐 따로 이렇게 딱 요약해서 집약적으로 수업해주는 그런 강의도 올라오나요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0080.wav",
                "duration": 5.373,
                "text": "지금 말씀드렸던 강좌는 중간고사 대비강좌이고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0081.wav",
                "duration": 5.279,
                "text": "o/ 기말 대비 김말 대비 강좌가 올라오실 텐데 가"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0082.wav",
                "duration": 9.109,
                "text": "환불액은 제가 말씀을 드렸고 이제 정확하게 좀 자세하게 학습 상담 뭐 해주시는 분도 계셔 가지고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0083.wav",
                "duration": 2.717,
                "text": "o/ 그쪽으로 한번 안내를 드릴께요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0084.wav",
                "duration": 3.271,
                "text": "아 네, 네, 혹시 그"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0085.wav",
                "duration": 3.998,
                "text": "들으실 거는 사회랑 한국사이시죠."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0086.wav",
                "duration": 3.475,
                "text": "네, 네, 네, 주목적은 그거 거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0087.wav",
                "duration": 5.299,
                "text": "네, 그리고 추가적으로는 이제 국영수도 생각하고 계시고요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0088.wav",
                "duration": 6.728,
                "text": "네, 네, 만약에 지금 보니까 패스로 사게 되면 큰 차이가 없다고 한다면"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0089.wav",
                "duration": 7.635,
                "text": "어차피 아이가 사회하고 한국사를 (1년)/(일 년)을 볼 거라고 생각을 하거든요. 그게 (1년)/(일 년)을 보는 비용이라면"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0090.wav",
                "duration": 6.486,
                "text": "패스로 들어갔을 때 (1년)/(일 년) 동은 국영수가 추가돼서 같이 비슷할 것이라고 보고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0091.wav",
                "duration": 3.217,
                "text": "그래가지고 여쭤보는 거거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0092.wav",
                "duration": 7.421,
                "text": "지금 인제 제가 말씀드렸던 (1강좌)/(한 강좌) 이렇게 신청하신다면 (100000원)/(십만 원)대 뭐 이렇게 되겠지만"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0093.wav",
                "duration": 10.882,
                "text": "그러니까 그니까 예를 들어서 제가 뭐 (3과목)/(세 과목) (수) 그 한거예요. (4과목)/(네 과목) 신청하게 된다면 패스 뭐 패스랑 가격이 거의 똑같다고 볼 것 같거든요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0094.wav",
                "duration": 3.38,
                "text": "o/ (4과목)/(네 과목) 정도 비해서는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0095.wav",
                "duration": 3.752,
                "text": "선생님과 한번 강좌 상담해보시면서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0096.wav",
                "duration": 5.869,
                "text": "단과로 수강하는 게 나으실지 한번 상담 받아보시는 게 나을 것 같아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0097.wav",
                "duration": 5.352,
                "text": "네, 네, 그래서 연락 받으실 번호 (1)/(하나)만 남겨주시겠어요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0098.wav",
                "duration": 3.069,
                "text": "언제까지 연락 주실 수 있으실까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0099.wav",
                "duration": 6.33,
                "text": "o/ 저희가 지금부터 (9시)/(아홉 시)까지 순차 연락이 가시는데 연락 어려우신 시간이 이제 있으신가요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0100.wav",
                "duration": 4.213,
                "text": "어 아니요. (9시)/(아홉 시)까지는 그 사이에 연락 주시면 좋을 것 같아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0101.wav",
                "duration": 5.331,
                "text": "네, 그럼 이제 최대한 빠르게 연락 드릴 수 있도록 전달해드릴 거고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000409/0102.wav",
                "duration": 3.738,
                "text": "알겠습니다. 그럼 저는 전화 기다리겠습니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000409/0103.wav",
                "duration": 2.345,
                "text": "네, 감사합니다."
            }
        ]
    }
