                    "age": "40대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                },
                {
                    "id": "2",
                    "type": "상담사1",
                    "age": "30대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0001.wav",
                "duration": 2.972,
                "text": "n/ 그 다름이 아니라요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0002.wav",
                "duration": 4.782,
                "text": "n/ 지금 카톡으로 질문을 제가 사실은 이게 처음이어서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0003.wav",
                "duration": 4.95,
                "text": "n/ 카톡으로 이거 (사) 사용을 어떻게 해야 되는지 질문을 드렸는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0004.wav",
                "duration": 5.099,
                "text": "n/ 거기는 기본적인 것만 알려주신다고 해가지고 뭐 링크를 보내주셨거든요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0005.wav",
                "duration": 3.305,
                "text": "n/ 도저히 그게 안 떠가지고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0006.wav",
                "duration": 3.075,
                "text": "우선은 저희가 수강을"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0007.wav",
                "duration": 3.203,
                "text": "n/ 그 눌렀어요. 저희 아이가"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0008.wav",
                "duration": 5.875,
                "text": "n/ o/ 신청할 거를 (누르고)/(눌르고) 저희는 패스를 구매했기 때문에 다 수강을 신청할 수 있고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0009.wav",
                "duration": 7.537,
                "text": "n/ 그리고 링크에 보내주신 거는 수강 신청하면 내 강의실이 바로 그 마이페이지 나와야 되는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0010.wav",
                "duration": 5.585,
                "text": "n/ o/ 저희는 보니까 온라인 서점이라는 걸 눌러야 여기 마이페이지가 뜨네요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0011.wav",
                "duration": 4.157,
                "text": "지금 컴퓨터로 보시는 거예요? 모바일로 보시는 거예요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0012.wav",
                "duration": 3.229,
                "text": "n/ 지금 태블릿에요. 그 아이패드."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0013.wav",
                "duration": 4.403,
                "text": "어플리케이션으로 보고 계세요? 아니면 사파리로 들어가셨어요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0014.wav",
                "duration": 3.869,
                "text": "n/ 지금 저희가 제가 온라인 그"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0015.wav",
                "duration": 4.528,
                "text": "n/ 거기에 온라인 서점을 눌렀더니 사파리로 들어간 거 같아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0016.wav",
                "duration": 7.315,
                "text": "아 네 일단은 애플리케이션에서 내 강의실 이동하시는 경로 알려드릴 건데 잠시 어플리케이션 화면 좀 봐주시겠어요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0017.wav",
                "duration": 6.405,
                "text": "o/ 네 보통은 이제 인터넷으로 들어가시면 내 강의실에서 보시는 화면이랑 동일하다고 보시면 되고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0018.wav",
                "duration": 6.4,
                "text": "o/ 여기에서 수강신청하신 강좌 중에 듣고 싶으신 강좌 제목을 눌러서 들어가시게 되면은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0019.wav",
                "duration": 3.211,
                "text": "o/ 이런 식으로 리스트가 나오실 거예요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0020.wav",
                "duration": 9.691,
                "text": "o/ 네 들으실 강의 뭐 (1강)/(일 강) 이렇게 터치를 하시게 되면 오른쪽에 (()) 하나가 펼쳐지면서 실시간 재생이나 다운로드 이런 걸 선택을 하실 수가 있거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0021.wav",
                "duration": 4.482,
                "text": "예 그렇게 해서 강좌를 들어주시면 된다고 생각하시면 되고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0022.wav",
                "duration": 8.776,
                "text": "o/ 만약에 웹사이트 기준 화면을 보시려고 하면 아무래도 어플리케이션보다는 그 사파리로 해서 들어가시는 게 더 나으실 수는 있는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0023.wav",
                "duration": 3.703,
                "text": "n/ o/ 지금 저희 사이트 자체 처음 이용하시는 거잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0024.wav",
                "duration": 6.448,
                "text": "그러면 아무래도 모바일이나 어플리케이션으로 보실 때 화면이 좀 간소화가 돼있거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0025.wav",
                "duration": 10.117,
                "text": "o/ 그래서 처음에 이용하실 때는 사이트 내용이나 이런 걸 적응을 좀 하실 때까지는 가능하면 컴퓨터로 해서 피씨버전의 화면을 전체적으로 한번 살펴보시고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0026.wav",
                "duration": 6.573,
                "text": "o/ 어느 정도 이제 익숙해지시면 그때부터 태블릿이나 아니면 스마트폰을 이용하시면 편하실 거고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0027.wav",
                "duration": 5.453,
                "text": "(1가지)/(한 가지) 유의하셔야 될 거는 이제 (ios)/(아이오에스) 아이패드를 사용하시잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0028.wav",
                "duration": 13.352,
                "text": "o/ 네 원래는 저희가 애플리케이션에서도 강좌 수강 신청하시고 나면은 교재 구매를 바로 할 수가 있긴 하신데 이제 애플 쪽에 정책으로 인해서 뭔가 결제를 해야 될 때는 인앱 결제밖에 안되도록 막아놨거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0029.wav",
                "duration": 12.264,
                "text": "o/ 그래서 애플 쪽에서 막아놓은 것 때문에 저희가 이거를 따로 결제 기능을 추가할 수가 없어서 혹시 교재 구매나 이런 걸 하실려면은 그 사파리로 해서 모바일 웹페이지로 들어가서 결제를 하시면 됩니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0030.wav",
                "duration": 5.208,
                "text": "뭔가 결제하시는 페이지라서 그래서 아마 사파리창이 열리셨을 거예요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0031.wav",
                "duration": 5.556,
                "text": "o/ 알겠습니다. 그럼 이쪽으로 가서 교재를 자 잠시만요. 제가 들어갔거든요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0032.wav",
                "duration": 5.523,
                "text": "o/ 저 옆에 온라인서점 위에 그 사람 모양이랑 그 옆에 재생 모양이 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0033.wav",
                "duration": 5.651,
                "text": "n/ 그럼 거기에 이제 강의실 제가 즐겨찾기 해놓은 강좌가 뜨는 거예요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0034.wav",
                "duration": 4.621,
                "text": "n/ 그럼 거기서 교재를 어떻게 사나요? 교재"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0035.wav",
                "duration": 9.508,
                "text": "o/ 아 네 교재 구매는 제가 다시 경로 알려드릴 건데 이건 모바일 기준으로 알려드릴 건데 지금 사파리에서 저희 모바일 화면으로 열리신 거 맞으시죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0036.wav",
                "duration": 4.937,
                "text": "o/ 예 그거 누르시면은 중간에 교재 구매라는 메뉴 (1)/(하나) 있거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0037.wav",
                "duration": 5.379,
                "text": "o/ 예 여기 들어가시면은 수강 중인 강좌의 교재를 모아서 보여드리기 때문에요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0038.wav",
                "duration": 7.789,
                "text": "따로따로 결제하기 번거로우시니까 원하시는 강좌를 쭉 수강신청하시고 나서 교재는 여기서 골라서 주문하시면 됩니다."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0039.wav",
                "duration": 6.718,
                "text": "n/ o/ 아 여기 보니까 국어가 되게 여러가진데 거기에서 내가 필요한 것만 사도 된다는거죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0040.wav",
                "duration": 9.039,
                "text": "네 맞습니다. 아마 강좌마다 주교재 부교재도 있을 거고 또 강의 특성상 교재가 꼭 필요한 강좌도 있겠지만 그렇지 않은 것도 있잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0041.wav",
                "duration": 5.848,
                "text": "n/ o/ 그래서 강의 뭐 들어보시고 나서 이건 교재가 필요하겠다 하는 것만 골라 주문하셔도 되고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0042.wav",
                "duration": 10.56,
                "text": "n/ o/ 뭐 문제풀이 위주라든가 수학이나 과학탐구 영역 쪽은 교재가 없으면 좀 듣기 어려우실 거니까 그런 것들은 이제 주교재 위주로는 구매를 아마 하셔야 될 가능성이 높을 거예요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0043.wav",
                "duration": 3.779,
                "text": "n/ o/ 아 이게 주교재가 다 떠있는 건가요? 그러면?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0044.wav",
                "duration": 5.577,
                "text": "네 보통은 주교재가 자동으로 보여지는데 부교재를 일단 같이 보여지기는 하거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0045.wav",
                "duration": 7.976,
                "text": "o/ 근데 뭐 강좌에 따라서는 이제 강의를 같이 듣고 나서 연습 삼아서 풀어봐야 되는 부교재들이 있을 수가 있어요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0046.wav",
                "duration": 10.054,
                "text": "n/ o/ 필수는 아니지만 학습에 도움되는 거라서 많이들 구매하시는 거니까 혹시라도 좀 부족하고 필요하다고 판단되면 부교재는 나중에 주문하시는 방법도 있긴 하세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000326/0047.wav",
                "duration": 2.792,
                "text": "o/ 음 예 알겠습니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000326/0048.wav",
                "duration": 2.387,
                "text": "o/ 네 감사합니다."
            }
        ]
    }
}