                    "age": "50대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                },
                {
                    "id": "2",
                    "type": "상담사1",
                    "age": "20대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0001.wav",
                "duration": 2.797,
                "text": "n/ 네 저 문의 좀 드리려고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0002.wav",
                "duration": 3.203,
                "text": "n/ 예 지금 고 (3)/(삼) 학생인데요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0003.wav",
                "duration": 8.467,
                "text": "n/ o/ 지금 인강을 구매하고 싶은데 어떤 게 좀 나은 건지 추천 좀 받고 싶어서 전화드렸거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0004.wav",
                "duration": 4.91,
                "text": "n/ 일단 저희 쪽에서는 학생 계정으로 가입을 하신 거죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0005.wav",
                "duration": 11.389,
                "text": "n/ o/ 단과로 이제 하나하나 보실 수가 있고요. 구매하신다면은 전 학년 전 강좌를 올해 (11월)/(십 일 월) (31일)/(삼십 일)까지 자유 수강하실 수가 있고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0006.wav",
                "duration": 11.336,
                "text": "n/ o/ 금액은 (52만원)/(오십 이만 원)이시고 추후 환급대상 학교에 만약에 입학을 하시는 경우에는 (100%)/(백 퍼센트) 장학금 형식으로 환급 해드리는 제도도 있으세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0007.wav",
                "duration": 5.256,
                "text": "n/ o/ 아 아니요. 저 그거는 지금 말씀하신 거는 제가 다 확인을 했고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0008.wav",
                "duration": 3.114,
                "text": "n/ o/ 확인은 하셨고요. 네."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0009.wav",
                "duration": 3.48,
                "text": "예예 근데 지금 비교하는 중인데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0010.wav",
                "duration": 10.212,
                "text": "o/ 윤리와 생활 그 다음에 또 (1)/(하나) 뭐였더라? 뭐 (3가지)/(세 가지)를 인강을 지금 들어야 되거든요? 고거 (3개)/(세 개)로 해가지고 교재까지"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0011.wav",
                "duration": 5.764,
                "text": "o/ 다 했더니 (503000원)/(오십만 삼천 원)인가 되더라고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0012.wav",
                "duration": 3.523,
                "text": "n/ 예 근데 옵션 중에"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0013.wav",
                "duration": 3.656,
                "text": "o/ 아까 말씀하신 (52만원)/(오십 이만 원)짜리요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0014.wav",
                "duration": 3.916,
                "text": "예 고거랑 지금 비교 중인데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0015.wav",
                "duration": 4.435,
                "text": "o/ (52만원)/(오십 이만 원)짜리는 전 과목을 다 들을 수 있는 거잖아요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0016.wav",
                "duration": 2.072,
                "text": "n/ 예예 맞아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0017.wav",
                "duration": 7.971,
                "text": "n/ 예 근데 아까 제가 말씀드린 거 뭐 (3개)/(세 개) 인강 (고르고)/(골르고) 교재까지 해서 (503000원)/(오십만 삼천 원) 어치 해놓은 거"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0018.wav",
                "duration": 5.324,
                "text": "o/ 한국사하고 뭐 여러 가지 지금 (3가지)/(세 가지)로 해놨는데 그분들이 지금"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0019.wav",
                "duration": 2.786,
                "text": "구매한 거 이외에"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0020.wav",
                "duration": 5.715,
                "text": "n/ 추가로 또 인강을 올리시면 그거는 또 따로 구매를 해야 되는 거죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0021.wav",
                "duration": 2.105,
                "text": "o/ 네 예 맞아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0022.wav",
                "duration": 11.309,
                "text": "아 그러면 그게 추가가 될 확률이 높지 않나요? 지금 (4월)/(사 월)밖에 안됐는데 입시 전에 또 인강이 나올 확률이 높은 거 아닌가요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0023.wav",
                "duration": 4.184,
                "text": "n/ o/ 일단은 그 커리큘럼에 맞춰서 인강이 나오시긴 하는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0024.wav",
                "duration": 6.056,
                "text": "n/ o/ 저희가 그러면 자세한 거는 학습상담 쪽으로 제가 연결을 해드릴게요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0025.wav",
                "duration": 11.149,
                "text": "n/ o/ 네 강좌 추천이나 그 선생님 추천도 받아보실 수가 있고요. 아니면은 이제 공부법이나 학습계획도 한번 (셀) 세워보실 수가 있으세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0026.wav",
                "duration": 3.075,
                "text": "n/ o/ 그쪽 안내해드려도 괜찮을까요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0027.wav",
                "duration": 2.956,
                "text": "아 예 예 바꿔주세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0028.wav",
                "duration": 14.267,
                "text": "n/ o/ 네 전문적인 학습 선생님께서 연락을 주시고요. 수강하고자 하시는 과목은 지금 장바구니에 넣어주셨던 한국사 생활과 윤리 그리고 한국지리 이게 다인가요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0029.wav",
                "duration": 9.741,
                "text": "n/ o/ 네네 그리고 상담 내용은 아까 말씀해 주셨던 선생님이나 강좌 추천외에도 다른 것도 상담받으실 부분 있으실까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0030.wav",
                "duration": 3.613,
                "text": "n/ o/ 그거는 고등부라 아예 다 별도예요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0031.wav",
                "duration": 5.139,
                "text": "받는게 있나 해가지고 그거 여쭤 (보려고)/(볼려고) 그런 거는 없나요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0032.wav",
                "duration": 10.293,
                "text": "n/ o/ 추가적인 할인 관련 상담도 받아보실 수는 있는데 그거를 학생 계정에 등록을 하신 다음에 (3만원)/(삼만 원) 할인받아보실 수 있는 방법도 있고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0033.wav",
                "duration": 4.484,
                "text": "달라고 지금 계속 문자를 했는데 전화가 없으셔가지고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0034.wav",
                "duration": 5.859,
                "text": "예 지금 오늘 (2번)/(두 번)이나 보냈는데도 연락이 안돼가지고 지금 여기로 전화한 거거든요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0035.wav",
                "duration": 2.067,
                "text": "o/ 아무튼 그러면"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0036.wav",
                "duration": 2.557,
                "text": "o/ 다른 그 아까"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0037.wav",
                "duration": 5.128,
                "text": "n/ 다 (2가지)/(두 가지) 다 뭐 상담할 수 있는 분하고 연결해주세요. 그러면."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0038.wav",
                "duration": 5.571,
                "text": "n/ 아 네 그게 학습상담 쪽이라서 제가 다 전달을 해드릴 거고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0039.wav",
                "duration": 3.789,
                "text": "n/ o/ 네 연락받으실 수 있는 번호는 어떻게 되세요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0040.wav",
                "duration": 14.632,
                "text": "n/ o/ 아 네네 확인 감사드리고요. 저희 쪽에서는 이제 전문적인 학습상담 선생님께서 연락을 주시는데 (1시)/(한 시)부터 (9시)/(아홉 시)까지 순차 연락가세요. 연락 불가능하신 시간 있으세요? 금일중에는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0041.wav",
                "duration": 3.171,
                "text": "n/ 불가능하신 시간은 없으시고요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0042.wav",
                "duration": 6.968,
                "text": "n/ o/ 네네네 빠른 시간에 좀 부탁드려요. 오늘 안으로 결제 (하려고)/(할려고) 지금 하는데."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0043.wav",
                "duration": 6.008,
                "text": "n/ o/ 네 그 부분은 제가 요청해드릴게요. 최대한 빠른 학습 시간 요청해주신다고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000329/0044.wav",
                "duration": 2.408,
                "text": "예 알겠습니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000329/0045.wav",
                "duration": 2.093,
                "text": "n/ 네 감사합니다."
            }
        ]
    }
}