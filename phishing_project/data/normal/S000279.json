        "dialogs": [
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000279/0001.wav",
                "duration": 3.699,
                "text": "그럼 인제 그 아이디랑 인제 비번이 있는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000279/0002.wav",
                "duration": 1.955,
                "text": "네네. 가입해 주시면 됩"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000279/0003.wav",
                "duration": 4.019,
                "text": "아. 그럼 탈퇴하고 다시 인제 해야 되겠네요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000279/0004.wav",
                "duration": 2.664,
                "text": "굳이 탈퇴하실 필요는 없고요. 에."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000279/0005.wav",
                "duration": 2.195,
                "text": "새로 만드시면 되세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000279/0006.wav",
                "duration": 3.341,
                "text": "아 네네. 알겠습니다."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000279/0007.wav",
                "duration": 2.269,
                "text": "네, 감사합니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000279/0008.wav",
                "duration": 2.152,
                "text": "네 고맙습, 네 고맙습니다."
            }
        ]
    }
