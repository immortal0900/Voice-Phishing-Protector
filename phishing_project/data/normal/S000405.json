                    "age": "40대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                },
                {
                    "id": "2",
                    "type": "상담사1",
                    "age": "40대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0001.wav",
                "duration": 3.869,
                "text": "학습에 대해서 궁금해서 전화드렸거든요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0002.wav",
                "duration": 4.744,
                "text": "아 저 딸아이가 고등학교 (1학년)/(일 학년)인데요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0003.wav",
                "duration": 8.877,
                "text": "어 그 어떻게 신청 혹시 어떻게 학습을 하고 그걸 좀 알 수 있을까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0004.wav",
                "duration": 3.795,
                "text": "혹시 학습 방법이나 뭐 강좌 추천"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0005.wav",
                "duration": 3.795,
                "text": "예 궁금해서 일단은 전화를 드렸거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0006.wav",
                "duration": 2.792,
                "text": "지금 사이트에 한번"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0007.wav",
                "duration": 5.427,
                "text": "사이트는 제가 들어갈 수가 없으니까 이렇게 전화를 드렸어요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0008.wav",
                "duration": 2.867,
                "text": "예 고 (1)/(일)부터 고 (3)/(삼)까지"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0009.wav",
                "duration": 2.497,
                "text": "혹시 뭐 그게 뭐"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0010.wav",
                "duration": 11.315,
                "text": "그 피씨 무슨 따로 그 인강으로 듣잖아요. 뭐 온라인으로 이렇게 시청을 하잖아요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0011.wav",
                "duration": 5.557,
                "text": "그러면 그 수업 시간이 이렇게 정해졌나요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0012.wav",
                "duration": 5.504,
                "text": "수강 기간이 따로 정해요. 어 수강 기간이 어"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0013.wav",
                "duration": 6.741,
                "text": "(83일)/(팔십 삼 일) 아니면 (130일)/(백 삼십 일) 이렇게 시간계 정해져 있는데 이거는 강좌마다 조금 차이가 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0014.wav",
                "duration": 6.597,
                "text": "아 근데 그 만약에 그 수강 (신) 그 수강시간이"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0015.wav",
                "duration": 8.9,
                "text": "이제 그 애가 인제 합격 끝 수업이 끝나고 뭐 이렇게 뭐 집에 와서 수강을 하는 거잖아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0016.wav",
                "duration": 2.874,
                "text": "근데 그 시간이"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0017.wav",
                "duration": 3.358,
                "text": "o/ 그런건 아니에요. 왜냐면 이게"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0018.wav",
                "duration": 3.885,
                "text": "그 동영상 역할을 해서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0019.wav",
                "duration": 7.817,
                "text": "o/ 업로드가 되는 거다 보니까 실시간으로 이제 수강을 하는 게 아니거든요. 수강 시간이 편하실 때 하신데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0020.wav",
                "duration": 2.662,
                "text": "아 편하실 때 아무 데나"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0021.wav",
                "duration": 6.639,
                "text": "o/ 아무 때나 내가 그 수업하고 시은 시간에 그 시간에"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0022.wav",
                "duration": 3.619,
                "text": "들어가서 이렇게 들을 수 있는 거예요? 네."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0023.wav",
                "duration": 2.376,
                "text": "아니면 태블릿에나"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0024.wav",
                "duration": 5.027,
                "text": "o/ 모바일 같은 거 사용하시면 거기에 다운로드도 받으시니까요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0025.wav",
                "duration": 3.069,
                "text": "아 다운로드요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0026.wav",
                "duration": 3.893,
                "text": "o/ 모든 기긴 아니고 기계 (1개)/(한 개)만 있어가지고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0027.wav",
                "duration": 9.304,
                "text": "근데 그게 그 태블릿 피씨는 나오는 건지 아니면은 뭐 핸드폰으로 아니 온라 뭐 피씨로 하는 건지"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0028.wav",
                "duration": 12.861,
                "text": "어 인터넷이 되는 환경의 피씨는 노트북이나 태블릿이나 다 사용 가능한 인터넷이 안돼서 다운로드를 아까 말씀드린것처럼 기기 등록하셔 가지고 다운로드 받을 수 있는 신청 기기가 정해져 있는 사용하"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0029.wav",
                "duration": 3.814,
                "text": "o/ 아 이게 기가 나오는 거는 아니죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0030.wav",
                "duration": 5.608,
                "text": "저희가 학습용으로 해서 판매를 하고 있긴 한데요. 그것만 꼭 사용하셔야 되는거는"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0031.wav",
                "duration": 2.739,
                "text": "아 하 그렇구나."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0032.wav",
                "duration": 6.232,
                "text": "아 다운로드 받아서 뭐 뭐 노트북이나 이런 데서 다 할 수 있다는 얘기네요. 그죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0033.wav",
                "duration": 5.757,
                "text": "어 다운로드 스마트폰이나 태블릿 중에 (1)/(하나) 선택하셔 가지고 등록을 받으셔"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0034.wav",
                "duration": 5.075,
                "text": "아 그러면 노트북으로 할 경우에는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0035.wav",
                "duration": 3.976,
                "text": "인터넷이 되시면은 아무 노트북에나 아이디 비밀번호"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0036.wav",
                "duration": 3.197,
                "text": "o/ 아 네, 아 해서 로그인"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0037.wav",
                "duration": 3.88,
                "text": "o/ 실시간은 아니고 스트리밍으로"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0038.wav",
                "duration": 2.937,
                "text": "그러면 그게 인제 뭐"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0039.wav",
                "duration": 9.49,
                "text": "o/ 그 (구 부 교) (()) 과목당 이게 저희는 어 영어하고 b/ 수학을 좀 생각하고 있는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0040.wav",
                "duration": 5.181,
                "text": "어 그렇게 되면 어떻게 금액이 어느 정도 나올까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0041.wav",
                "duration": 8.947,
                "text": "금액이 강좌별로 선생님별로 다 차이가 있어 가지고 (100000원)/(십만 원) 있고 아니면 더 그 이상 이하도 있어 가지고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0042.wav",
                "duration": 6.237,
                "text": "보통 시간으로 따지는 거예요? 아니면 (1주일)/(일 주일)에 면 몇 번 이렇게 (10000원)/(만 원)"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0043.wav",
                "duration": 7.912,
                "text": "수강기간이 스스로 그 달라지는 것 같긴 하더라고요. 근데 그 딱 정확게 그렇게 말씀드린데 저희가"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0044.wav",
                "duration": 7.56,
                "text": "(12월)/(십 이 월) (31일)/(삼십 일 일)까지 저희 모든 강좌 고등학교 (1학년)/(일 학년) (2학년)/(이 학년) (3학년)/(삼 학년) 전강좌 다 들을때"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0045.wav",
                "duration": 4.093,
                "text": "회원제 전 강좌 다하세요. 전 과목 강의도"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0046.wav",
                "duration": 8.509,
                "text": "아 금액이 고등학교 (1학년)/(일 학년)이라고 하셨었잖아요. 수강권만 어 (490000원)/(사십 구만 원)이거든요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0047.wav",
                "duration": 3.035,
                "text": "아 전 과목 (12월)/(십 이 월)까지요. (12월)/(십 이 월)까지요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0048.wav",
                "duration": 2.803,
                "text": "(12월)/(십 이 월) (31일)까지."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0049.wav",
                "duration": 4.483,
                "text": "o/ 전 과목을 들을 수 있다는 얘기죠? 그걸로"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0050.wav",
                "duration": 10.333,
                "text": "o/ 토요일 같은 경우 첨삭이 추가로 비용이 추가될 수가 있는데요. 이렇게 뭐 첨삭 첨삭해주고 그런 서비스 아니라 그냥 동영상 강의 같은 전강의 다 듣고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0051.wav",
                "duration": 3.16,
                "text": "o/ 그냥 (500000원)/(오십 만 원) 안팎이라는 얘기네요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0052.wav",
                "duration": 3.044,
                "text": "o/ 이것보다 이제 강좌를"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0053.wav",
                "duration": 3.599,
                "text": "적게 해 수강하신다면 단과로"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0054.wav",
                "duration": 7.347,
                "text": "o/ 과목 과목을 이렇게 정해서 뭐 (2과목)/(두 과목) 정도 한다고 그러면은 영어하고 수학정도"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0055.wav",
                "duration": 5.139,
                "text": "아니면 (490000원)/(사십 구만 원) 이상 강좌를 구해서 이용하시는 게 더 저렴하여"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0056.wav",
                "duration": 3.091,
                "text": "아 전과목을 했을 때"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0057.wav",
                "duration": 7.857,
                "text": "일단 사이트 들어가셔 가지고 그 수강 과목 정하신 다음에 이제 금액이랑 이렇게 대비하시"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0058.wav",
                "duration": 4.643,
                "text": "아 사이트 들어가서 이게 상담으로 나올 수 없는가 보네요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0059.wav",
                "duration": 5.071,
                "text": "왜냐면 직접 강좌를 인제 확인하시고 선택해 주셔야 되시니까요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0060.wav",
                "duration": 2.709,
                "text": "아 그렇구나. 아 네."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0061.wav",
                "duration": 9.896,
                "text": "o/ 강좌 추천이나 학습 상담 같은 거 많은데 저희 사이트에 로그인하면 그 어 비상담 신청도 가능하세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000405/0062.wav",
                "duration": 5.341,
                "text": "아 네, 네, 알겠습니다. 아휴 어쨌든 감사합니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000405/0063.wav",
                "duration": 1.619,
                "text": "네, 감사합니다."
            }
        ]
    }
}