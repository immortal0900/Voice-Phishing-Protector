                    "age": "30대",
                    "gender": "남",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0001.wav",
                "duration": 4.214,
                "text": "교재중에 궁금한 게 있어서 문의 좀 하려고 하는데요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0002.wav",
                "duration": 3.68,
                "text": "요 최근에 나온 혹시 교재 있나요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0003.wav",
                "duration": 3.052,
                "text": "n/ 어 회원님 우선 아이디 한번 불러주시겠어요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0004.wav",
                "duration": 3.278,
                "text": "아이디가요. 잠깐만요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0005.wav",
                "duration": 4.765,
                "text": "n/ 네 성함이 어떻게 되실까요? 어 확인 되셨고요. 잠시만요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0006.wav",
                "duration": 2.627,
                "text": "제일 최근에 나온 교재를"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0007.wav",
                "duration": 4.323,
                "text": "o/ 네 그 왜 저기 어디인가 그때"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0008.wav",
                "duration": 3.676,
                "text": "어 저희가 (7월)/(칠 월) 말까지"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0009.wav",
                "duration": 2.596,
                "text": "혹시 나온 게 있나 해서요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0010.wav",
                "duration": 4.391,
                "text": "o/ (7월)/(칠 월) (7월)/(칠 월) 달에 뭐 (하) 하여튼"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0011.wav",
                "duration": 3.869,
                "text": "n/ 뭐 그때 그렇게 얘기하셨던 것 같은데."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0012.wav",
                "duration": 4.93,
                "text": "일단 그 지금 (3강좌)/(세 강좌)가 있기는 한데 그 교재"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0013.wav",
                "duration": 3.907,
                "text": "n/ o/ (7월)/(칠 월) (1일)/(일 일) 날 발행된 걸로 ((확인되세요))."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0014.wav",
                "duration": 2.531,
                "text": "이게 가장 최근이에요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0015.wav",
                "duration": 3.48,
                "text": "그러면 아까 봤던 게 이거야?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0016.wav",
                "duration": 2.964,
                "text": "n/ 아까 아까 봤던 게 이건가?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0017.wav",
                "duration": 5.547,
                "text": "n/ 어 이게 (2권)/(두 권)? (2권)/(두 권) 이야? 이게 (1권)/(한 권) 인가요? (2권)/(두 권) 인가요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0018.wav",
                "duration": 2.669,
                "text": "o/ 네 교재가 (1권)/(한 권)이에요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0019.wav",
                "duration": 4.013,
                "text": "하실 때는 이제 아마 따로따로 가긴 하실 거예요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0020.wav",
                "duration": 2.605,
                "text": "이렇게 나눠져 있다 생각하시면 되세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0021.wav",
                "duration": 4.201,
                "text": "네 그럼 요게 확실해"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0022.wav",
                "duration": 2.664,
                "text": "현장편인가요? 이게?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0023.wav",
                "duration": 9.715,
                "text": "n/ 현장편이라고 나와있네요. 그리고 이 전 단계로 한번 들어가봐. 이거? 어 이 보면은"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0024.wav",
                "duration": 4.88,
                "text": "n/ 여기 패키지 강좐가? 패키지 강좌에서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0025.wav",
                "duration": 3.187,
                "text": "n/ 이게 그냥 합쳐 놓은 건가요? 그러면?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0026.wav",
                "duration": 2.989,
                "text": "n/ 어떤 걸 합쳐 놨단 말씀이세요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0027.wav",
                "duration": 2.941,
                "text": "네 패키지 강좌에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0028.wav",
                "duration": 3.091,
                "text": "n/ o/ 아 이 패키지 강좌 말씀하시는 거예요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0029.wav",
                "duration": 3.133,
                "text": "n/ o/ 따로따로 돼있는 걸 합쳐 놓은 건가요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0030.wav",
                "duration": 7.933,
                "text": "n/ o/ 단과 강좌에 (2강좌)/(두 강좌)를 이게 합쳐서 조금 싸게 구매를 하실 수 있도록 만들어 놓은 강좌가 패키지 강좌고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0031.wav",
                "duration": 5.125,
                "text": "n/ o/ 이거는 이제 단과 강좌에 그 (2강좌)/(두 강좌)를 그냥 합쳐 놨다 생각하시면 되세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0032.wav",
                "duration": 4.897,
                "text": "o/ 다만 이제 뭐 교재라든지 이런 거는 따로따로 이제 되기 때문에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0033.wav",
                "duration": 5.581,
                "text": "강좌가 그냥 조금 싸게 이제 구매를 하실 수 있는 걸로 ((확인이))"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0034.wav",
                "duration": 6.349,
                "text": "n/ 이게 잠깐만 어 이게 너무 비슷한 게 너무 많아가지고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0035.wav",
                "duration": 2.968,
                "text": "o/ 이게 또 그 밑에l/ 보면은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0036.wav",
                "duration": 3.272,
                "text": "o/ 다시 (1번)/(한 번) 말씀해 주세요. 어 어떤거 말씀하시는 거예요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0037.wav",
                "duration": 2.873,
                "text": "아 그 밑으로 또 보면"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0038.wav",
                "duration": 10.109,
                "text": "n/ o/ 이제 위에꺼는 현장 버전이고 아래꺼는 이제 스튜디오에서 찍으신 버전이라고 생각하시면 될 (()) 이건 그냥 선택을 해서 원하시는거 들으셔도 상관 없으시고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0039.wav",
                "duration": 5.405,
                "text": "또 아까 처음에 소개하셨던 최근에 나왔던 거"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0040.wav",
                "duration": 5.102,
                "text": "그거랑은 다른 건가요? 제일 처음에 얘기해 주셨던 거."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0041.wav",
                "duration": 2.653,
                "text": "o/ 네 네 맞아요. 어 그거"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0042.wav",
                "duration": 2.6,
                "text": "o/ 발행된 교재 말씀하시는 거예요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0043.wav",
                "duration": 4.429,
                "text": "네네 그거 그거랑 지금 이거랑은 또 다른 거예요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0044.wav",
                "duration": 6.28,
                "text": "n/ o/ 그 (7월)/(칠 월) (1일)/(일 일) 날 발행된 그 교재랑 어떤 거랑 지금 비교를 하시는 거예요? 패키지 강좌"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0045.wav",
                "duration": 3.805,
                "text": "n/ o/ 어머니 지금 보고 계신 게 단과 강좌 페이지예요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0046.wav",
                "duration": 6.408,
                "text": "어 네 지금 그 밑으로 패키지 밑으로 또 단과 밑으로도 내려왔거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0047.wav",
                "duration": 5.566,
                "text": "n/ o/ 그 위에 보시면 제일 위에 보시면은 전체 강좌 단과 강좌 패키지 강좌 이런 식으로 나눠져 있잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0048.wav",
                "duration": 3.235,
                "text": "n/ o/ 거기서 단과 강좌 한번 클릭해 보시겠어요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0049.wav",
                "duration": 6.668,
                "text": "n/ o/ 보면은 그 두 번째부터 이제 세 번째 네 번째 이렇게 보시면은 현장 버전 스튜디오 버전"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0050.wav",
                "duration": 2.109,
                "text": "이렇게 (3개)/(세 개) 나와있잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0051.wav",
                "duration": 4.243,
                "text": "n/ o/ 이게 지금 전부 다 나와있는 거고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0052.wav",
                "duration": 2.611,
                "text": "그 제가 말씀드린 거는 이제"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0053.wav",
                "duration": 3.208,
                "text": "현장 버전의 그 교재를 말씀을 드린거고."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0054.wav",
                "duration": 3.146,
                "text": "그 보시면은 밑에 스튜디오 버전 있잖아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0055.wav",
                "duration": 4.413,
                "text": "o/ 스튜디온지 현장인지는 중요하지 않고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0056.wav",
                "duration": 2.526,
                "text": "그걸 물어보는 게 아니라"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0057.wav",
                "duration": 5.48,
                "text": "지금 아까 얘기했던 그 (7월)/(칠 월) (1일)/(일 일) 날 나온 게"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0058.wav",
                "duration": 3.091,
                "text": "지금 단과에서 보이는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0059.wav",
                "duration": 3.155,
                "text": "코드가 있잖아요. 그 코드가 같잖아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0060.wav",
                "duration": 4.001,
                "text": "o/ 교재 보면은 코드가 있어요? 어"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0061.wav",
                "duration": 3.63,
                "text": "o/ 코드가 같으면은 아예 같은 교재라고 생각하시면 되세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0062.wav",
                "duration": 4.127,
                "text": "이거 그러면 지금 또 보이는 게"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0063.wav",
                "duration": 4.557,
                "text": "그러면 이거는 어떻게 신청을"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0064.wav",
                "duration": 3.231,
                "text": "o/ 파일로 해서 받을 수 있는 거네요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0065.wav",
                "duration": 2.728,
                "text": "o/ 파일 다운로드 받으시면 되세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0066.wav",
                "duration": 4.84,
                "text": "음 이게 요것도 최근에 나온 건가요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0067.wav",
                "duration": 2.627,
                "text": "강좌를 말씀하시는 거예요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0068.wav",
                "duration": 6.447,
                "text": "n/ o/ 이게 보시면은 라이브로 진행이 되는 거라 위에 보시면 (8월)/(팔 월) (10일)/(십 일) (10시)/(열 시)에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0069.wav",
                "duration": 6.333,
                "text": "o/ 개강이 된 건 아니고 지금 결제를 해주시는 (8월)/(팔 월) (10일)/(십 일) 라이브로 들으실 수 있다는 걸 말씀을 드리는 거고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0070.wav",
                "duration": 3.581,
                "text": "아 이건 거 같은데 이게"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0071.wav",
                "duration": 11.111,
                "text": "n/ o/ 아 그럼 이거는 지금 결제는 되고 그럼 파일을 갖고 있을 수 있다가 이제 (10일)/(십 일) 부터 그러면 요거를 수강을 할 수 있다는 얘기인 거죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0072.wav",
                "duration": 3.715,
                "text": "네 그렇게 해주시면 되시는데 잠시만요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0073.wav",
                "duration": 6.717,
                "text": "이것도 그러면 최근에 나온 거잖아요? 앞으로 할 강좌를 이렇게 해놓은 거니까"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0074.wav",
                "duration": 10.499,
                "text": "음 아 알겠습니다. 그러면 이거랑 교재를 그러면 이건 파일이니까 받을 수 있는 게 아니 그냥 여기서 받으면 되는 거고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000148/0075.wav",
                "duration": 6.955,
                "text": "n/ 파일 제거 이라고 돼있는데? 이거 어떻게 해야 돼 그럼? 파일 제거 하고 이거 결제를 하면은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0076.wav",
                "duration": 2.723,
                "text": "n/ 거기 보시면은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0077.wav",
                "duration": 3.368,
                "text": "어 강의 클릭해서 한번 들어가 보시겠어요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000148/0078.wav",
