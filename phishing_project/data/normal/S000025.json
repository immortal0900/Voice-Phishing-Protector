        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000025/0001.wav",
                "duration": 2.401,
                "text": "네 수고하십니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000025/0002.wav",
                "duration": 4.498,
                "text": "네 입시 상담 신청은 하실 수 있어요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000025/0003.wav",
                "duration": 4.456,
                "text": "o/ 로그인만 (그니까)/(그까) 회원가입만 (1번)/(한 번) 해주시면 월 (2번)/(두 번)은 가능하세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000025/0004.wav",
                "duration": 7.48,
                "text": "혹시 월 (2번)/(두 번)까지 하고 그 후로 계속 이용을 할 수 있는 거예요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000025/0005.wav",
                "duration": 4.755,
                "text": "그니까 월에 (2번)/(두 번)이니까. 이제 다음 달 되면 또 (2번)/(두 번)이 생기시는 거죠."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000025/0006.wav",
                "duration": 2.423,
                "text": "아 월 (2번)/(두 번)까지만요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000025/0007.wav",
                "duration": 5.681,
                "text": "그 월에 그럼 (2번)/(두 번) 이상 좀 하고 싶다라고 하면은 뭐."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000025/0008.wav",
                "duration": 4.424,
                "text": "o/ 여쭤보셔야 돼요. 거기 담당부서에 이게 신청하시는 거라서."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000025/0009.wav",
                "duration": 4.311,
                "text": "o/ 그거 눌러보시면 입시상담 이제 신청하실 수 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000025/0010.wav",
                "duration": 4.2,
                "text": "아 그래요. 네 네 알겠습니다."
            }
        ]
    }
}