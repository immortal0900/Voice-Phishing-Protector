                    "age": "50대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                },
                {
                    "id": "2",
                    "type": "상담사1",
                    "age": "30대",
                    "gender": "남",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0001.wav",
                "duration": 5.1,
                "text": "n/ 아 네 지금 가입을 구매를 하려고 하는데요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0002.wav",
                "duration": 3.0,
                "text": "n/ 그거를 구입을 하려고 하는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0003.wav",
                "duration": 3.491,
                "text": "o/ 이게 교재를 받아서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0004.wav",
                "duration": 5.843,
                "text": "n/ o/ 시작 시작이 어떻게 되는지 우선 가입을 하고 구매를 하게 되면"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0005.wav",
                "duration": 3.517,
                "text": "n/ 그 교재도 선택을 해야 되잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0006.wav",
                "duration": 7.814,
                "text": "n/ o/ 그쵸. 교재 필요하시면 교재는 구매하셔야 되시고요. 구매일 다음날부터 이제 미션이 시작이 되는 겁니다. 시작일은 따로 조정"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0007.wav",
                "duration": 2.579,
                "text": "n/ o/ 아니요. 구매일로부터"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0008.wav",
                "duration": 3.254,
                "text": "n/ o/ 교재가 없는데 어떻게 이거를 가능"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0009.wav",
                "duration": 3.624,
                "text": "n/ 교재 교재 같은 경우는"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0010.wav",
                "duration": 3.997,
                "text": "n/ o/ 일단 저희가 (()) 배송되는 진행건이잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0011.wav",
                "duration": 5.614,
                "text": "n/ o/ 네 (()) 요거에 대해서 미리 이제 예습을 하시면서 시간을 채우시는 거예요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0012.wav",
                "duration": 3.197,
                "text": "n/ o/ 아 교재 받기전에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0013.wav",
                "duration": 5.782,
                "text": "n/ o/ 아 (1시간)/(한 시간) 이상 채우시되 정확하게 (1시간)/(한 시간) 채우시면 안 되고 넉넉하게"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0014.wav",
                "duration": 3.805,
                "text": "n/ o/ 네 (1시간)/(한 시간) 이상으로 (()) 해주셔야 되시고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0015.wav",
                "duration": 5.364,
                "text": "n/ o/ 미션형 환급 안내사항이 있어요. 그 부분에 이제 유의사항이 나와있거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0016.wav",
                "duration": 2.728,
                "text": "n/ 네 무조건 듣는 게 아니라"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0017.wav",
                "duration": 7.645,
                "text": "n/ o/ 플레이어에 따라서 진행이 되는 거기 때문에 이제 와이파이나 데이터 모델를 꼭 확인해 주셔야 되시고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0018.wav",
                "duration": 4.269,
                "text": "n/ o/ 네 그 부분 (()) 진행해주시면 되시고 구매일로부터"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0019.wav",
                "duration": 4.051,
                "text": "n/ o/ 그 다음날 바로 미션 진행되니까 그 부분 참고해 주시면"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0020.wav",
                "duration": 6.856,
                "text": "n/ o/ 오늘 오늘 구매를 하면은 내일서부터는 교재를 받든 안 받든 진행을 해야 된다는 얘기신 거잖아요. 그죠?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0021.wav",
                "duration": 3.012,
                "text": "n/ 이게 가능할까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0022.wav",
                "duration": 11.837,
                "text": "n/ o/ 어 네 뭐 불가능하진 않으세요. 왜냐면은 일단 기본적으로 뭐 물론 교재가 당연히 뭐 있어야 되는 게 맞지만 그거에 대해서 미리 한번 훑어보는 거예요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0023.wav",
                "duration": 11.597,
                "text": "n/ o/ 영상을 보면서 이 선생님에 대해서 파악하는 것도 있고 모든 학년 고등학교 (1)/(일) (2)/(이) (3학년)/(삼 학년) 과정과 모든 선생님 모든 과목을 다 수강을 할 수 있는 거예요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0024.wav",
                "duration": 10.378,
                "text": "n/ o/ 네 그거에 대해서 다 선생님거를 들어를 (바) 봐야 어떠한 강좌가 나한테 맞는지 학생 회원님한테 맞는지에 따라"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0025.wav",
                "duration": 4.579,
                "text": "n/ o/ 네 무조건 교재를 다 구매하는 게 아니라 한번 들어보시고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0026.wav",
                "duration": 11.345,
                "text": "n/ o/ 그런데 이게 지금 학원에서만 공부하던 친구라 혼자 공부하면은 자기가 뭐가 필요하고 제가 봤을 때는 잘 모를 것 같은 거지"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0027.wav",
                "duration": 7.171,
                "text": "n/ o/ 그니까 학습상담을 애 애기가 직접 하는 게 나은 거잖아요. 그죠? 애가 직접 하는 게 낫지 않나?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0028.wav",
                "duration": 2.803,
                "text": "n/ o/ 하셔도 되고 뭐 어머님"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0029.wav",
                "duration": 3.252,
                "text": "n/ 학습 상담을 좀 (받았) 네."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0030.wav",
                "duration": 2.533,
                "text": "n/ 혹시 아이디 있으신가요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0031.wav",
                "duration": 2.861,
                "text": "n/ o/ 가입은 잠시만요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0032.wav",
                "duration": 7.629,
                "text": "n/ o/ 확인 감사드리고요. 어 그럼 어떻게 전과목으로 좀 추천을 희망을 할까요? 그 예약을?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0033.wav",
                "duration": 3.715,
                "text": "n/ o/ 우선은 방학 동안에"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0034.wav",
                "duration": 5.192,
                "text": "n/ o/ 국영수를 좀 집중적으로 좀 해야 될 것 (같아요)/(같애요). 수능이랑"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0035.wav",
                "duration": 5.404,
                "text": "n/ o/ 수능이랑 내신 대비해서 공부를 해야 해야 될 것 같거든요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0036.wav",
                "duration": 2.675,
                "text": "n/ o/ 우선은 방학 동안에"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0037.wav",
                "duration": 11.06,
                "text": "n/ o/ 좀 플랜을 좀 짜야 될 것 (같아요)/(같애요). 그리고 그거는 계속 쭉 갈 거고 나머지 이제 사탐이나 이런 것들은 이제 자기 혼자 스스로 공부를 해야 되는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0038.wav",
                "duration": 6.931,
                "text": "n/ o/ 이거를 선택을 한다거나 지금 이거가 강좌가 되게 많잖아요. 선생님들도 되게 많"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0039.wav",
                "duration": 6.799,
                "text": "n/ o/ 근데 그쪽에서는 이제 인기 선생님은 아무래도 잘하니까 인기 선생님이겠죠? 그죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0040.wav",
                "duration": 8.862,
                "text": "n/ o/ 못 하고의 차이는 아니에요. 그냥 수강생 차이인 거지. 왜냐면 이제 학생들이 다 이제 성향과 유형이 다르기 때문에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0041.wav",
                "duration": 5.027,
                "text": "n/ 뭐 일타 뭐 강사님들이 잘 가르친다 이런 잘하고 못하고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0042.wav",
                "duration": 5.197,
                "text": "n/ o/ 어 그 선생 선생님을 떠나서 우선은 그러면 선생님은 떠나서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0043.wav",
                "duration": 8.056,
                "text": "n/ o/ 그 국영수를 대비해서 어떤 방학 동안에는 어떤 공부를 하는 게 좋다 뭐 이런 거 있잖아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0044.wav",
                "duration": 3.395,
                "text": "n/ 네 그런 거를 좀 받고 싶어요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0045.wav",
                "duration": 2.285,
                "text": "n/ 아 학습상담을요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0046.wav",
                "duration": 6.553,
                "text": "n/ o/ 아 네네 그러시면 뭐 어머님께 연락드리는 게 좋을까요? 아니면 저희가 순차적으로 연락을 드리는 거라서."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0047.wav",
                "duration": 5.451,
                "text": "n/ o/ 저희가 (1시)/(한 시) 부터 학습 상담이 진행이 되고요. 저녁 (8시)/(여덟 시) 까지. 네"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0048.wav",
                "duration": 5.864,
                "text": "n/ o/ 그래서 그 사이에 연락을 드릴 거기 때문에 혹시 뭐 어머니 받으시는 게 나을까요? 아니면"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0049.wav",
                "duration": 2.483,
                "text": "n/ o/ 제가 제가 받을게요. 제가."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0050.wav",
                "duration": 3.965,
                "text": "n/ 아 네 그러시면 어머님 번호 한번 남겨주시겠어요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0051.wav",
                "duration": 6.001,
                "text": "n/ o/ 아까 안내해드렸던 (1시)/(한 시) 부터 (8시)/(여덟 시) 사이에 순차적으로 예약된 순차적으로 연락되는 거기 때문에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0052.wav",
                "duration": 6.34,
                "text": "n/ o/ 어 참고 부탁드리고요. 고 (2)/(이) 학생 국어 영어 수학 수능대비 강좌 추천 희망으로 해서 네 그렇게"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0053.wav",
                "duration": 4.616,
                "text": "n/ o/ (()) 갈 거니까 받아주시면 되시고 혹시 어머니 연락받으시기 전에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0054.wav",
                "duration": 6.483,
                "text": "n/ o/ 연락처에 수신 차단되어있진 않으신 지 (1번)/(한 번) 더 확인해주시면 되겠습니다."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0055.wav",
                "duration": 4.184,
                "text": "n/ o/ 베이직이랑 프리미엄인가 뭐 그렇게 (3가지)/(세 가지)가 있는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0056.wav",
                "duration": 5.982,
                "text": "n/ 그래도 어떤 게 그래도 난 거예요? 그 기간에 따라서 다르겠지만."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0057.wav",
                "duration": 5.84,
                "text": "n/ 해지 (하) 해지율도 있고 막 그렇잖아요. 하다가 중간에 멈추고 막 이런 것도 있는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0058.wav",
                "duration": 9.187,
                "text": "n/ o/ 아 그건 내가 선택해야 되는 거지 그래도 아 보통 이렇게 되면 중간에 끊던가 뭐 이런 것들도 있잖아요. 그런 거 대비해서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0059.wav",
                "duration": 5.389,
                "text": "n/ o/ 지금 처음 시작하는 거라 얘가 맞을지 안 맞을지도 정확하게 제가 잘 모르겠어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000149/0060.wav",
                "duration": 2.223,
                "text": "n/ o/ 알겠습니다. 감사합니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000149/0061.wav",
                "duration": 2.243,
                "text": "n/ o/ 네 감사합니다."
            }
        ]
    }
}