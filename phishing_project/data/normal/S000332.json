                    "age": "50대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                },
                {
                    "id": "2",
                    "type": "상담사1",
                    "age": "20대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0001.wav",
                "duration": 4.907,
                "text": "n/ o/ 지금 가입하면 그 금액이 어느 정도인지도 궁금하고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0002.wav",
                "duration": 6.083,
                "text": "n/ 가입하실 때는 일단 학생 계정으로 가입을 하셔서 로그인을 해주셔야 되고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0003.wav",
                "duration": 14.323,
                "text": "n/ o/ 가입하실 때 학생 계정으로 가입을 하셔서 로그인하셔야 네 강좌나 그 원하시는 상품을 구매하실 수가 있고요. 단과는 이제 강좌 하나하나마다 수강을 하실 수가 있으세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0004.wav",
                "duration": 4.008,
                "text": "그러면 전체 전 과목을 하게 되면은 어떻게"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0005.wav",
                "duration": 5.32,
                "text": "n/ o/ 그렇게 되면은 금액이 (52만원)/(오십 이만 원)과 (72만원)/(칠십 이만 원)이 있으세"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0006.wav",
                "duration": 6.125,
                "text": "n/ 이게 (1년)/(일 년) 기준인데 지금 벌써 (3개월)/(삼 개월)이 훨 지나갔잖아요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0007.wav",
                "duration": 10.552,
                "text": "o/ 그 (52만원)/(오십 이만 원) 구매를 하시면 (1년)/(일 년)은 아니시고 전 학년 전 강좌를 올해 (12월)/(십 일 월) (31일)/(삼십 일 일)까지 무제한 수강하실 수가 있고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0008.wav",
                "duration": 8.589,
                "text": "별도로 구매를 하셔야 되고 프리미엄 (72만원)/(칠십 이만 원) 구매하시면 안에 교재 캐시 금액이 포함되어 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0009.wav",
                "duration": 5.291,
                "text": "이게 지금 (4월)/(사 월)부터 들어야 되는데도 (52만원)/(오십 이만 원) 다 내야 된다는 얘기예요? 다 들으려면?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0010.wav",
                "duration": 4.605,
                "text": "n/ o/ 예 전체 들으시려면은 (1번)/(한 번)에 (52만원)/(오십 이만 원) 결제해 주셔야"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0011.wav",
                "duration": 4.299,
                "text": "원래 (1월)/(일 월)에 했으면 어떻게 그때도 (52)/(오십 이)였어요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0012.wav",
                "duration": 4.214,
                "text": "n/ o/ 그때는 금액이 좀 높았을 거예요. 인상된 금액"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0013.wav",
                "duration": 6.744,
                "text": "o/ 아닌데. 그렇지 않은데. 제가 그때도 알아봤었는데 그때도 이 금액이었던 것 같은데요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0014.wav",
                "duration": 4.889,
                "text": "그때 아마 이벤트했을 수도 있어요. 지금은 이전보다는 좀"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0015.wav",
                "duration": 3.849,
                "text": "(52)/(오십 이) (55)/(오십 오)에서 (52)/(오십 이)로 인하돼서 판매했어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0016.wav",
                "duration": 3.103,
                "text": "n/ 지금 (3개월)/(삼 개월)이 훨씬 지나갔는데도요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0017.wav",
                "duration": 5.809,
                "text": "다 듣는 것도 아니고 시간도 없어서도 못 듣는데 이 단과는 얼마씩이나 하는데요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0018.wav",
                "duration": 5.849,
                "text": "n/ 단과는 이제 선생님 강좌마다 금액이랑 기간이 좀 차이가 있으세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0019.wav",
                "duration": 2.829,
                "text": "듣는 선생님 어떤 분이세요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0020.wav",
                "duration": 3.411,
                "text": "아니 이제 얘가 과학을 좀 들어보고 싶어해서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0021.wav",
                "duration": 3.757,
                "text": "과학도 지금 여러 선생님 계시는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0022.wav",
                "duration": 9.979,
                "text": "n/ o/ 강좌는 강좌비용이 (147000원)/(십 사만 칠천 원)이고 교재비용이 (28000원)/(이만 팔천 원)이시고 이제 수강기간이 (146일)/(백 사십 육 일)이에요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0023.wav",
                "duration": 4.322,
                "text": "음 그렇게 딱 몇 개월 딱 그렇게 정해져 있는 거예요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0024.wav",
                "duration": 2.43,
                "text": "o/ 네 이렇게 다 달라요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0025.wav",
                "duration": 4.157,
                "text": "음 그럼 우선 (비교해보려면)/(비교해볼려면은)"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0026.wav",
                "duration": 8.479,
                "text": "o/ 뭐 어떻게 해야 되나요? 우선 들어가봐야 알 텐데 우선 돈을 돈부터 결제를 한 다음에 들어가 봐야 되는 건지 아니면"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0027.wav",
                "duration": 5.112,
                "text": "o/ 아니요. (비) 비회원 상태에서 저희 홈페이지 접속을 하신 다음에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0028.wav",
                "duration": 4.483,
                "text": "원하시는 선생님 클릭하셔서 개설 강좌 보시면 돼요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0029.wav",
                "duration": 3.217,
                "text": "아 개설 강좌를 보면 된다고요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0030.wav",
                "duration": 7.162,
                "text": "음 근데 생각보다 되게 비싸네요. 이게 프리미엄은 또 무슨 저기라 했지 (72만원)/(칠십 이만 원)씩이나 하나."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0031.wav",
                "duration": 5.419,
                "text": "n/ 교재 캐시 (24만원)/(이십 사만 원)이 포함되어 있는 게 (72만원)/(칠십 이만 원)이세요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0032.wav",
                "duration": 2.788,
                "text": "교재가 포함되어 있다고요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0033.wav",
                "duration": 6.08,
                "text": "네 근까 (52만원)/(오십 이만 원)에 (20만원)/(이십만 원) 더하면 프리미엄 구매를 하실 수가 있는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0034.wav",
                "duration": 5.441,
                "text": "n/ o/ (20만원)/이십만 원)은 캐시로 들어가고 추가로 (4만원)/(사만 원) 더 증정하고 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0035.wav",
                "duration": 3.635,
                "text": "많이 듣지도 (못 할)/(모 달) 것 같긴 한데 시간이 없어서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0036.wav",
                "duration": 3.0,
                "text": "n/ 생각을 해주셔야 될 것 (같아요)/(같애요)."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0037.wav",
                "duration": 4.637,
                "text": "n/ o/ 음 (4월)/(사 월) (12일)/(십 이 일)까지는 (52만원)/(오십 이만 원)에 판매해요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0038.wav",
                "duration": 2.236,
                "text": "그럼 그 다음부터는요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0039.wav",
                "duration": 4.413,
                "text": "n/ o/ 그 다음부터는 금액이 변동되거나 그럴 수도 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0040.wav",
                "duration": 2.232,
                "text": "n/ 어떻게 변동이 된다는거"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0041.wav",
                "duration": 4.476,
                "text": "n/ 정확하게는 알 수 없고 인상될 것 같지는 않은데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0042.wav",
                "duration": 5.517,
                "text": "n/ o/ (13일)/(십 삼 일) 오전에 정확하게 알 수가 있어요. 미리 공지는 안되어 있어서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0043.wav",
                "duration": 4.643,
                "text": "o/ 더 비싸지진 않겠죠? 지금 날짜가 지금 (3)/(삼) 분의 (1)/(일)이 다 갔는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0044.wav",
                "duration": 5.46,
                "text": "n/ 네 그럴 것 같긴 한데 정확한 거는 (13일)/(십 삼 일) 오전에 알 수가 있어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0045.wav",
                "duration": 3.725,
                "text": "(13일)/(십 삼 일) 오전에. (3만원)/(삼만 원) 할인권을"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0046.wav",
                "duration": 2.147,
                "text": "n/ o/ 네 혹시 받아보셨"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0047.wav",
                "duration": 7.379,
                "text": "n/ 예 받은 받은 게 있는데 그게 지금도 쓸 수 있는 건지 그때 (1월)/(일 월)달 (2월)/(이 월)달 그때 얘기했었거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0048.wav",
                "duration": 9.236,
                "text": "n/ 그거 아마 유효 있을 텐데 유효기간이 안 지났으면은 쓸 수 사용하실 수가 있고 유효기간이 만료되었으면 사용이 어려우셔요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0049.wav",
                "duration": 9.128,
                "text": "n/ o/ 근데 그 유효기간이 언젠지를 몰라서 그때 예 (1월)/(일 월)달 (2월)/(이 월)달 그때쯤 하게 되면 사용하라고 주셨던 거"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0050.wav",
                "duration": 6.04,
                "text": "n/ o/ 그분한테 다시 또 연락이 안될 텐데 아 그분한테 연락을 해봐야 된다는 거예요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0051.wav",
                "duration": 2.976,
                "text": "n/ 학습상담 요청해드릴까요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0052.wav",
                "duration": 2.563,
                "text": "네네네 그런 거. 예."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0053.wav",
                "duration": 5.245,
                "text": "n/ o/ 아 네네. 그리고 학습상담 받으실 때 또 어떤 부분을 받고 싶나요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0054.wav",
                "duration": 9.053,
                "text": "n/ o/ 이제 강좌 뭐 이런 거 선생님 같은 거 이제 어 어떤 분이 좋은지 이런것 이제 과목별로 좀 알려주셨으면 좋고 좋겠고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0055.wav",
                "duration": 3.485,
                "text": "n/ (그니까)/(그까) 애가 좀 공부를 좀 잘해서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0056.wav",
                "duration": 3.357,
                "text": "좀 잘 좀 들어보고 싶은데 음."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0057.wav",
                "duration": 4.42,
                "text": "n/ 네 그러면은 그 관련해서 제가 전달해드릴 거고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0058.wav",
                "duration": 2.595,
                "text": "(얼) 오늘 연락 주시는 거예요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0059.wav",
                "duration": 7.197,
                "text": "n/ 네 금일 중에 이제 (1시)/(한 시)부터 (9시)/(아홉 시)까지 순차 연락가실 거예요. 네 이 번호로 전화"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0060.wav",
                "duration": 3.346,
                "text": "n/ o/ 네 한번 연락받아보고 싶네요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0061.wav",
                "duration": 2.653,
                "text": "n/ 네 이건 전달해드릴게요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0062.wav",
                "duration": 4.97,
                "text": "n/ 예 그 한 낮 시간은 조금 피해주셨으면 좋겠는데 한"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0063.wav",
                "duration": 4.013,
                "text": "n/ o/ 언제쯤 피해줬으면 (좋게) 좋으실까요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0064.wav",
                "duration": 2.542,
                "text": "오전이 좋을 것 같아요. 오전."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0065.wav",
                "duration": 3.48,
                "text": "n/ 어 오전은 어려우세요. (1시)/(한 시)이후부터"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0066.wav",
                "duration": 3.04,
                "text": "아 (1시)/(한 시)이후부터 라고요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0067.wav",
                "duration": 2.802,
                "text": "어 그럼 (4시)/(네 시)쯤"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0068.wav",
                "duration": 2.787,
                "text": "n/ (4시)/(네 시)로 전달해드릴까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000332/0069.wav",
                "duration": 4.655,
                "text": "n/ 아 네네 그럼 이때 이후로 학습상담 전달해드릴게요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000332/0070.wav",
                "duration": 3.165,
