{
    "dataSet": {
        "version": "1.0",
        "date": "null",
        "typeInfo": {
            "category": "교육",
            "subcategory": "공부방법",
            "place": "null",
            "inputType": "전화",
            "speakers": [
                {
                    "id": "1",
