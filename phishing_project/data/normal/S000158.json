                    "type": "고객1",
                    "age": "40대",
                    "gender": "여",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0001.wav",
                "duration": 6.077,
                "text": "네 교재를 해가지고 구입을 하려 하는데 이게 잘 클릭이 안되거든요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0002.wav",
                "duration": 6.035,
                "text": "아 네 어 (왜) 저희 그러시면 저희 회원님 아이디 혹시 확인 가능하실까요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0003.wav",
                "duration": 5.699,
                "text": "네 어머니 혹시 지금 교재 구매 원하시는 강좌명 어떻게 되실까요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0004.wav",
                "duration": 5.395,
                "text": "o/ (1)/(원) (2022)/(이 공 이 이) 필수본 개념완성 기본부터 심화까지"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0005.wav",
                "duration": 4.968,
                "text": "어머니 해당 (꼭) 교재 해당 강좌 이제 클릭해주시고요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0006.wav",
                "duration": 9.235,
                "text": "해당 강좌 이제 (클릭하셔서)/(클릭해셔서) 접속을 하시면 이제 선생님 사진 있고 그 아래에 쭉 내려오시면 수강퀵메뉴 있습니다."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0007.wav",
                "duration": 5.096,
                "text": "거기에 이제 학습 (q&a)/(큐앤에이) 질문하기랑 이제 교재 구매 보이실까요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0008.wav",
                "duration": 5.801,
                "text": "거기 클릭하셔서 보시면 이제 구매 가능한 교재가 뜹니다. 어머님."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0009.wav",
                "duration": 4.732,
                "text": "o/ 이게 근데 교재 구매를 제가 클릭을 했는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0010.wav",
                "duration": 3.197,
                "text": "이게 교재가 안 떠요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0011.wav",
                "duration": 5.544,
                "text": "혹시 교재가 안뜬다는 게 교재가 장바구니 담기지 않는다는 말씀이실까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0012.wav",
                "duration": 10.11,
                "text": "네 이게 클릭이 안되거든요. 지금 제가? 이게 뭔가가 지금 뭘 막고 있어서 그런걸까요? 이게 교재 구매를 제가 눌렀거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0013.wav",
                "duration": 3.266,
                "text": "네 근데 그게 안 (뜨더라고요)/(뜨더라구요)."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0014.wav",
                "duration": 4.064,
                "text": "장바구니 담기지 않는다는 말씀이신가요. 어머니?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0015.wav",
                "duration": 8.336,
                "text": "o/ 아니 클릭 자체가 안돼요. (()) 표시가 되는데 (누르면은)/(눌르면은) 이게 교재가 떠야 되잖아요 그게 안돼요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0016.wav",
                "duration": 4.307,
                "text": "잠시만요. 어머니. 제가 (1번)/(한 번) 확인해보도록 하겠습니다."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0017.wav",
                "duration": 5.139,
                "text": "어머니 제가 (1번)/(한 번) 방금 이제 회원님 아이디"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0018.wav",
                "duration": 6.116,
                "text": "계정으로 장바구니 (1번)/(한 번) 교재 담아봤는데 지금 저희 쪽에서는 진행이 되고 있거든요. 어머니?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0019.wav",
                "duration": 3.475,
                "text": "수강 강좌 전체 보기를 (하고요)/(하구요)."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0020.wav",
                "duration": 5.459,
                "text": "o/ 선생님 물리학 (가) 기본부터 심화까지 필수 (()) (들어가고요)/(들어가구요)."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0021.wav",
                "duration": 4.136,
                "text": "네 그럼 전체 (58강)/(오십 팔 강) 강의가 있고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0022.wav",
                "duration": 7.016,
                "text": "o/ 그리고 거기 교재 구매를 (밀리) 클릭을 하면 이게 클릭이 저는 안되거든요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0023.wav",
                "duration": 6.952,
                "text": "o/ 오? 정말요. 어머니? 저 저희 쪽에서는 지금 어머니 지금 혹시 지금 사용 중인 인터넷 환경"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0024.wav",
                "duration": 4.769,
                "text": "o/ 크롬이나 (()) 익스플로러 중에 어떤 거 이용 중이세요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0025.wav",
                "duration": 8.275,
                "text": "그냥 마이크로소프트 그냥 인터넷 그걸로 하고 있거든요? 엣지나 크롬으로 해야 되나요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0026.wav",
                "duration": 5.715,
                "text": "어 아니요. 저희가 익스플로러로 이용을 권장드리고 있기 때문에 여쭤봤고요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0027.wav",
                "duration": 4.713,
                "text": "o/ 그거는 어 제가 강의실 중에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0028.wav",
                "duration": 3.688,
                "text": "수강신청 강좌 전체 보기에서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0029.wav",
                "duration": 3.432,
                "text": "선생님 꺼는 제가 담았어요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0030.wav",
                "duration": 12.659,
                "text": "o/ 교재 구매가 이거는 된 상태거든요? 교재? 어 이것도 여기서는 이거 이 강의로 들어가서 하는 게 아닌가요? 여기로 들어가서 할 수 있는 거 제가 (그리고)/(그르고) 수강"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0031.wav",
                "duration": 6.44,
                "text": "네 그리고 오른쪽에 마이페이지에 들어가서 내일 강의실로 들어가잖아요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0032.wav",
                "duration": 8.595,
                "text": "어 그래갖고 수강 강좌 전체 보기 이쪽으로 들어가서 하면는 그게 왜 안되는지 모르겠어요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0033.wav",
                "duration": 4.072,
                "text": "선생님 교재처럼 구매를 똑같이 하시면 되시거든요. 어머님?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0034.wav",
                "duration": 5.096,
                "text": "어 근데 지금 아예 (그니까)/(그까) 교재 구매 버튼을 (누르시는)/(눌리시는) 거예요. 어머니?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0035.wav",
                "duration": 3.709,
                "text": "뭐 버튼이 안 눌려요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0036.wav",
                "duration": 6.909,
                "text": "그 교재 구매하고 그 숫자 (3)/(삼)이라고 써져있는 그 (수) 교재 구매버튼 아예 안 눌리시단 말씀이신가요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0037.wav",
                "duration": 9.405,
                "text": "o/ 그거를 눌러서 들어가야 되는 거죠? 그러면은 (()) 오늘강의 옆에 있는 교재 구매를 눌러갖고 들어갈 수도 있는 거죠?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0038.wav",
                "duration": 3.24,
                "text": "어디요 어머님? 다시 (1번)/(한 번) 말씀해주시겠어요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0039.wav",
                "duration": 8.024,
                "text": "o/ 마이페이지에 노란색이 내 강의실 빨간색이 원스탑 수강신청 그다음에 하늘색이 교재 구매잖아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0040.wav",
                "duration": 2.273,
                "text": "(여기로)/(욜로) 들어가도 되죠?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0041.wav",
                "duration": 4.262,
                "text": "어 네 맞습니다. 어머니. 거기에서 하시면 가장 빨라요. 네"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0042.wav",
                "duration": 3.864,
                "text": "o/ 근데 이것도 저는 클릭이 지금 안되거든요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0043.wav",
                "duration": 2.814,
                "text": "어 클릭자체가 안되세요? 어머니?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0044.wav",
                "duration": 5.949,
                "text": "인터넷 (1번)/(한 번) 그 사용 중이신 인터넷 창 (1번)/(한 번) 껐다가 다시 해보셨는데도 안되시는 걸까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0045.wav",
                "duration": 4.394,
                "text": "o/ 아 그렇게는 안 해봤어요. 그러면 껐다가 다시 (1번)/(한 번) 해볼까요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0046.wav",
                "duration": 4.008,
                "text": "네 (1번)/(한 번) 껐다가 다시 (1번)/(한 번) 해봐주세요. 어머님 네"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0047.wav",
                "duration": 5.011,
                "text": "아 그럼 로그아웃을 시켰다가 다시 들어가라는 거죠?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0048.wav",
                "duration": 4.776,
                "text": "o/ 네 네 (1번)/(한 번) 네 다시 처음부터 (1번)/(한 번) 네 진행해보도록 하겠습니다. 어머니"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0049.wav",
                "duration": 3.795,
                "text": "o/ 아 네 알겠습니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0050.wav",
                "duration": 4.136,
                "text": "o/ 로그인부터 다시 하면 되나요? 로그인부터?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0051.wav",
                "duration": 4.925,
                "text": "(1번)/(한 번) 네 (해) 일단 해보시고 네 저한테 말씀해주세요. 어머님 제가 기다리고 있겠습니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0052.wav",
                "duration": 5.608,
                "text": "네 어 (됐고요)/(됐구요). 잠시만요. 마이페이지를 들어가서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0053.wav",
                "duration": 9.107,
                "text": "o/ 마이페이지 들어와서 내 강의실을 먼저 들어가는 거잖아요. 내 강의실로 들어가고 그리고 수강 강좌 본 다음에"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0054.wav",
                "duration": 5.364,
                "text": "o/ 물리학을 들어가서 교재 구매를 (누르면)/(눌르면) 되는거죠?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0055.wav",
                "duration": 7.177,
                "text": "o/ 네 아니시면 아까 말씀하신 대로 그 옆에 있던 동그라미 파란색 교재 구매 버튼에서 하셔도 돼요. 어머니."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0056.wav",
                "duration": 2.664,
                "text": "아 그게 안돼요. 이게"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0057.wav",
                "duration": 9.144,
                "text": "o/ 근데 제가 오늘 신청을 했거든요. 그러면은 수강이 (10일)/(십 일) 뒤부터 된다고 이렇게 (뜨더라고요)/(떠더라고요)."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0058.wav",
                "duration": 4.563,
                "text": "그럼 강의를 지금 들을 수가 없나요? 오늘 신청했는데?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0059.wav",
                "duration": 3.901,
                "text": "어 아니요? 오 강좌를 수강하실 수 있어요. 어머님."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0060.wav",
                "duration": 5.957,
                "text": "o/ 강좌는 오늘부터 수강을 해야 되는 거죠? 그게 스타트가 오늘이죠?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0061.wav",
                "duration": 3.244,
                "text": "어머니 이거 혹시 결제 언제 하셨어요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0062.wav",
                "duration": 6.594,
                "text": "o/ 아까 오전 오강중에 아 (11시)/(열 한 시)에서 (12시)/(열 두 시) 사이에 그때 했거든요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0063.wav",
                "duration": 6.937,
                "text": "아 오늘 하시면 저희 미션은 내일부터 시작이에요. 오늘부터 수강은 가능하신데 미션은 내일부터 집계 됩니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0064.wav",
                "duration": 3.331,
                "text": "o/ 아 미션은 내일부터예요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0065.wav",
                "duration": 6.803,
                "text": "o/ 네 그러면은 교재 교재 신청은 오늘 할 수 있는 거잖아요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0066.wav",
                "duration": 1.993,
                "text": "그렇죠. 어머니."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0067.wav",
                "duration": 5.523,
                "text": "o/ 선생님 해가지고 강좌를 들어갔었거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000158/0068.wav",
                "duration": 7.699,
                "text": "o/ 그럼 여기에 있는 이 강좌로 들어가서 장바구니로 구매하기 이렇게 들어가도 될까요? 교재?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000158/0069.wav",
                "duration": 2.889,
                "text": "네 네 어머니 그렇게 하셔도 돼요."
            },
            {
