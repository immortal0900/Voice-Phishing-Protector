                    "age": "40대",
                    "gender": "남",
                    "residence": "알수없음",
                    "telephone_network": "8k"
                }
            ]
        },
        "dialogs": [
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0001.wav",
                "duration": 2.56,
                "text": "컴퓨터로 (보려고)/(볼라고) 그러거든요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0002.wav",
                "duration": 2.54,
                "text": "그걸 어떻게 해야 되죠?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0003.wav",
                "duration": 5.493,
                "text": "네 (()) 으로 저기 태블릿으로 (듣) 보기는 있는데 너무 작아서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0004.wav",
                "duration": 6.548,
                "text": "o/ 네 그거를 이제 그 노트북으로 노트북이나 데스크 탑으로 연결해서 (보려)/(볼라) 그러는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0005.wav",
                "duration": 2.86,
                "text": "무슨 프로그램을 깔아야 되나요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0006.wav",
                "duration": 9.843,
                "text": "어 저희가 일단 강좌 이제 플레이를 하시려면 저희 이 강좌 재생하는 전용 프로그램이 있어서 그거를 따로 설치하시면 (되시고요)/(되시구여)."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0007.wav",
                "duration": 5.224,
                "text": "고것만 설치하면 따로 그냥 다른 거 설치 없이 그냥 볼 수 있는 건가요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0008.wav",
                "duration": 2.109,
                "text": "어 네 그렇습니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0009.wav",
                "duration": 6.749,
                "text": "어 b/ 아니 그 태블릿을으로 (보) 보는 거는 그러면 컴퓨터가 어떤 차이가 있는 거죠?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0010.wav",
                "duration": 9.224,
                "text": "오 저 이건 아마 태블릿이랑 노트북이랑은 아마 저희가 b/ 어 (화) 보이시는 화면이 저희가 같은 것으로 저희가 알고 있습니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0011.wav",
                "duration": 9.277,
                "text": "o/ 화면 지금 노트북으로는 안 보고 그 프로그램이 어 잘 노트북에서 잘 동작이 안돼서"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0012.wav",
                "duration": 6.184,
                "text": "음 혹시 저희 강좌 어떤 강좌 b/ 혹시 지금 결제해서 수강 예정이실까요?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0013.wav",
                "duration": 7.4,
                "text": "아뇨. 지금 그 원래 회원으로 그 어 저희 딸애가 회원으로 가입해서 지금 오랫동안 듣고 있는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0014.wav",
                "duration": 6.035,
                "text": "네 태블릿이 그 (()) 영상이 너무 작게 나와서"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0015.wav",
                "duration": 4.456,
                "text": "눈 예 좀 효율이 떨어지는가 봐요. 눈도 아프고"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0016.wav",
                "duration": 4.989,
                "text": "그래서 (노) 노트북이나 데스크 (()) 일반 테스크 탑 컴퓨터"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0017.wav",
                "duration": 4.253,
                "text": "모니터에 연결해 듣고요. 모니터로 (보려고)/(볼라) 그러면은"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0018.wav",
                "duration": 3.485,
                "text": "어 네 지금 아까 말씀하신 그"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0019.wav",
                "duration": 3.934,
                "text": "그 프로그램만 설치하는 걸로 끝난다 이 말인가요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0020.wav",
                "duration": 5.436,
                "text": "네 저희 피씨에서 어 저희 강의 재생하실 때 저희 말씀하신"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0021.wav",
                "duration": 3.953,
                "text": "설치해서 네 재생하시면 바로 수강 가능하세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0022.wav",
                "duration": 2.998,
                "text": "다른 거 다른 방법은 없습니까?"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0023.wav",
                "duration": 11.11,
                "text": "o/ 어 일반 컴퓨터하고 호환이 잘 안되고 그걸 깔고 나면 컴퓨터가 l/ 굉장히 동작이 느려지고 막 이런 b/ 문제가 있어요. 그 아시는지 모르겠는데"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0024.wav",
                "duration": 7.093,
                "text": "아 근데 저희가 일단은 저희 강좌를 재생을 하시려면 해당 플레이어는 설치가 필요해서요. 아버님"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0025.wav",
                "duration": 4.744,
                "text": "네 그 번거로우시겠지만n/ 네 설치해서 네 수강 부탁드립니다."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0026.wav",
                "duration": 10.792,
                "text": "o/ 네 b/ 그러면 b/ (태블릿을)/(태블리블) 저 저희 아이가 중학교 때부터 들어가지고 지금 태블릿은 b/ 어 갤럭시 (4)/(폰)가를 사용하고 있는데"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0027.wav",
                "duration": 6.429,
                "text": "그거를 예 그거를 버전을 좀 새로운 기기로 (바꾸려면)/(바꿀라면은) 어떻게 되나요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0028.wav",
                "duration": 10.771,
                "text": "어 새로운 기기로 변경을 원하시면 저희가 이제 b/ 지금 지금 사용 중신 태블릿에 지금 회원님이 로그인해서 기기 등록해놓으셨잖아요."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0029.wav",
                "duration": 2.685,
                "text": "그 기기 등록 해제하시고"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0030.wav",
                "duration": 7.357,
                "text": "변경하실 태블릿으로 저희 어플 설치하시고 다시 로그인하셔서 해당 기기 다시 기기 등록하시면 되세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0031.wav",
                "duration": 2.611,
                "text": "아무 기기나 구입을 해서요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0032.wav",
                "duration": 5.779,
                "text": "o/ 네 (그) 그렇습니다. 제일 싸다고 가격이 제일 저렴하다고 말씀드릴 수 없지만"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0033.wav",
                "duration": 3.816,
                "text": "그 앱이나 이런 동작방식은 다 동일한가요?"
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0034.wav",
                "duration": 6.387,
                "text": "네 (저희)/(거희) 저 그냥 네 시중에 판매하는 탭을 저희 사이트에서 네 판매 중인 거예요. 아버님"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0035.wav",
                "duration": 2.931,
                "text": "o/ 아 그래요. 네, 네"
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0036.wav",
                "duration": 2.621,
                "text": "네 알겠습니다."
            },
            {
                "speaker": "1",
                "audioPath": "D01/J01/S000195/0037.wav",
                "duration": 3.06,
                "text": "o/ 감사합니다. 좋은 하루 되세요."
            },
            {
                "speaker": "2",
                "audioPath": "D01/J01/S000195/0038.wav",
                "duration": 2.364,
                "text": "네 고맙습니다."
            }
        ]
    }
}