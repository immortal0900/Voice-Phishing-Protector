      "confidence": -0.2471910042876608
    },
    {
      "index": 62,
      "start": 171.0,
      "end": 176.0,
      "text": "이게 진행이 끝난 다음에 그때는 공개가 가능하거든요.",
      "speaker": "speaker_1",
      "confidence": -0.2471910042876608
    },
    {
      "index": 63,
      "start": 176.0,
      "end": 181.0,
