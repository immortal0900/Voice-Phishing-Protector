      "confidence": -0.17390536992563366
    },
    {
      "index": 40,
      "start": 125.0,
      "end": 127.0,
      "text": "모르신다고 전혀 피해 보시는 부분은 없으실 거예요?",
      "speaker": "speaker_1",
      "confidence": -0.17390536992563366
